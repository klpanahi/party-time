# Single source of truth for party-time's two public/LAN hostnames.
#
# Sourced (not executed) by deploy.sh and ops/healthcheck.sh. The ${VAR:-default}
# form means an already-exported environment variable always wins, so a one-off
# deploy to a different host is just:
#   PARTY_TIME_PUBLIC_URL=https://staging.example.com ./deploy.sh
#
# deploy/party-time.yml receives both as -e party_time_public_url=... /
# -e party_time_admin_url=... and derives nginx server_name from them via the
# urlsplit filter — the URL and the vhost hostname can never drift apart.

PARTY_TIME_PUBLIC_URL="${PARTY_TIME_PUBLIC_URL:-https://party-time.panahi-systems.com}"
PARTY_TIME_ADMIN_URL="${PARTY_TIME_ADMIN_URL:-http://party-time.nginx-internal.local}"
