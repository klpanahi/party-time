# ---------------------------------------------------------------------------
# Sample local environment configuration for party-time.
#
# Usage:
#   cp sample.local.env local.env   # then fill in the REAL values below
#
# run_local.sh sources local.env (if present) so these variables are exported
# into the local stack. local.env is gitignored — never commit real secrets.
#
# Every value here is OPTIONAL: the backend falls back to the defaults shown in
# the comments when a variable is unset. The Twilio block is the exception —
# leave it blank to run without SMS delivery (texts simply stay 'pending').
# ---------------------------------------------------------------------------

# --- Admin API -------------------------------------------------------------
# Enables the /admin routes. run_local.sh runs the backend with this on.
# Default (when unset): false
ADMIN_ENABLED=true

# Base URL used to build invite links sent to guests.
# Default: http://localhost:5174
INVITEE_BASE_URL=http://localhost:5174

# --- Database --------------------------------------------------------------
# These must match docker-compose.yml (myuser / mypassword / party-time-db).
# The database name is fixed to "party_time" in code and is not configurable.
# Defaults: myuser / mypassword / 127.0.0.1 / 5432
DBUSER=myuser
DBPASS=mypassword
DBHOST=127.0.0.1
DBPORT=5432

# --- Twilio (SMS delivery) -------------------------------------------------
# Leave ALL THREE blank to disable the text worker (texts stay 'pending').
# Set all three to enable real SMS sending via Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Text worker tuning (optional) -----------------------------------------
# How often the worker polls for pending texts (Go duration, e.g. 3s, 500ms).
# Default: 3s
TEXT_WORKER_INTERVAL=3s

# Delay between individual sends, in milliseconds (basic rate limiting).
# Default: 1100
TEXT_WORKER_RATE_MS=1100
